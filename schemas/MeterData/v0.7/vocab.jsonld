{
    "@context": {
        "@version": 1.1,
        "ies": "https://raw.githubusercontent.com/India-Energy-Stack/ies-accelerator/main/schemas/ies/",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "schema": "https://schema.org/"
    },
    "@graph": [
        {
            "@id": "ies:MeterData",
            "@type": "rdfs:Class",
            "rdfs:label": "Meter Data",
            "rdfs:comment": "Root payload can be a single profile or an array of profiles."
        },
        {
            "@id": "ies:EnergyData",
            "@type": "rdfs:Class",
            "rdfs:label": "Energy Data",
            "rdfs:comment": "A single compact data-only profile record. Must be one of the eight standard types."
        },
        {
            "@id": "ies:CustomerProfile",
            "@type": "rdfs:Class",
            "rdfs:label": "Customer Profile",
            "rdfs:comment": "Slow-changing customer + service-point + meter-list summary."
        },
        {
            "@id": "ies:BaseProfile",
            "@type": "rdfs:Class",
            "rdfs:label": "Base Profile",
            "rdfs:comment": "Root base profile carrying common identifiers across all shapes."
        },
        {
            "@id": "ies:IntervalProfile",
            "@type": "rdfs:Class",
            "rdfs:label": "Interval Profile",
            "rdfs:comment": "Block Load Survey — PT15M / PT30M cadence intervalBlocks for one meter."
        },
        {
            "@id": "ies:DailyProfile",
            "@type": "rdfs:Class",
            "rdfs:label": "Daily Profile",
            "rdfs:comment": "Daily Load Profile — P1D intervalBlocks. Same per-meter shape as IntervalProfile."
        },
        {
            "@id": "ies:MonthlyProfile",
            "@type": "rdfs:Class",
            "rdfs:label": "Monthly Profile",
            "rdfs:comment": "Monthly profile readings from the meter at billing reset time (billing history)."
        },
        {
            "@id": "ies:BillDetails",
            "@type": "rdfs:Class",
            "rdfs:label": "Bill Details",
            "rdfs:comment": "Utility billing computed details, such as billing amount, bill number, due dates, and prepaid balance."
        },
        {
            "@id": "ies:InstantaneousProfile",
            "@type": "rdfs:Class",
            "rdfs:label": "Instantaneous Profile",
            "rdfs:comment": "Snapshot of a meter's electrical quantities at one captured moment."
        },
        {
            "@id": "ies:AlarmProfile",
            "@type": "rdfs:Class",
            "rdfs:label": "Alarm Profile",
            "rdfs:comment": "Real-time active indicators/alerts representing immediate state conditions from the meter."
        },
        {
            "@id": "ies:EventProfile",
            "@type": "rdfs:Class",
            "rdfs:label": "Event Profile",
            "rdfs:comment": "IS 15959 event log for one meter over a coverage period."
        },
        {
            "@id": "ies:Identifier",
            "@type": "rdfs:Class",
            "rdfs:label": "Identifier",
            "rdfs:comment": "Canonical {scheme, value} reference. Used for customer/meter/SDP/OBIS references."
        },
        {
            "@id": "ies:TimePeriod",
            "@type": "rdfs:Class",
            "rdfs:label": "Time Period",
            "rdfs:comment": "Period defined by a start time and a duration."
        },
        {
            "@id": "ies:ReadingDefinition",
            "@type": "rdfs:Class",
            "rdfs:label": "Reading Definition",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:PayloadDescriptorSet",
            "@type": "rdfs:Class",
            "rdfs:label": "Payload Descriptor Set",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:CompactSequence",
            "@type": "rdfs:Class",
            "rdfs:label": "Compact Sequence",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:SequenceItem",
            "@type": "rdfs:Class",
            "rdfs:label": "Sequence Item",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:PayloadDescriptor",
            "@type": "rdfs:Class",
            "rdfs:label": "Payload Descriptor",
            "rdfs:comment": "One quantity declared once per block; rows' values[] align positionally with descriptors[]."
        },
        {
            "@id": "ies:IntervalPeriod",
            "@type": "rdfs:Class",
            "rdfs:label": "Interval Period",
            "rdfs:comment": "Period defined by a start time and a duration."
        },
        {
            "@id": "ies:Interval",
            "@type": "rdfs:Class",
            "rdfs:label": "Interval",
            "rdfs:comment": "One time-series interval row. payloads[k] is the value for compactSequence[k]."
        },
        {
            "@id": "ies:Override",
            "@type": "rdfs:Class",
            "rdfs:label": "Override",
            "rdfs:comment": "Sparse — inject timestamps, zones, or validation states into specific interval cells."
        },
        {
            "@id": "ies:Reading",
            "@type": "rdfs:Class",
            "rdfs:label": "Reading",
            "rdfs:comment": "Detailed, self-contained inline reading with full metadata support."
        },
        {
            "@id": "ies:TouBucket",
            "@type": "rdfs:Class",
            "rdfs:label": "Tou Bucket",
            "rdfs:comment": "Time of Use bucket separating readings by zone."
        },
        {
            "@id": "ies:Customer",
            "@type": "rdfs:Class",
            "rdfs:label": "Customer",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:ServiceDeliveryPoint",
            "@type": "rdfs:Class",
            "rdfs:label": "Service Delivery Point",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:Meter",
            "@type": "rdfs:Class",
            "rdfs:label": "Meter",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:Association",
            "@type": "rdfs:Class",
            "rdfs:label": "Association",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:MeterEvent",
            "@type": "rdfs:Class",
            "rdfs:label": "Meter Event",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:MeterAlarm",
            "@type": "rdfs:Class",
            "rdfs:label": "Meter Alarm",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:ServiceLocation",
            "@type": "rdfs:Class",
            "rdfs:label": "Service Location",
            "rdfs:comment": "Coarse, non-PII location of the metered service, for aggregation. Carries no street-level address; use CustomerProfile.serviceDeliveryPoints[].address for a full address."
        },
        {
            "@id": "ies:PayloadDescriptorProfile",
            "@type": "rdfs:Class",
            "rdfs:label": "Payload Descriptor Profile",
            "rdfs:comment": "Configuration profile representing a collection of Payload Descriptor Sets exchanged out-of-band or embedded in an array."
        },
        {
            "@id": "ies:CustomerDetails",
            "@type": "rdfs:Class",
            "rdfs:label": "Customer Details",
            "rdfs:comment": "PII sub-object. Omit entirely for anonymised or pseudonymous exchange."
        },
        {
            "@id": "ies:profileType",
            "@type": "rdf:Property",
            "rdfs:label": "profile Type",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:customerRefs",
            "@type": "rdf:Property",
            "rdfs:label": "customer Refs",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:timeZone",
            "@type": "rdf:Property",
            "rdfs:label": "time Zone",
            "rdfs:comment": "IANA time-zone, e.g. Asia/Kolkata."
        },
        {
            "@id": "ies:customerDetails",
            "@type": "rdf:Property",
            "rdfs:label": "customer Details",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:customer",
            "@type": "rdf:Property",
            "rdfs:label": "customer",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:serviceDeliveryPoints",
            "@type": "rdf:Property",
            "rdfs:label": "service Delivery Points",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:meters",
            "@type": "rdf:Property",
            "rdfs:label": "meters",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:associations",
            "@type": "rdf:Property",
            "rdfs:label": "associations",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:meterRefs",
            "@type": "rdf:Property",
            "rdfs:label": "meter Refs",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:serviceDeliveryPointRefs",
            "@type": "rdf:Property",
            "rdfs:label": "service Delivery Point Refs",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:payloadDescriptorSetRef",
            "@type": "rdf:Property",
            "rdfs:label": "payload Descriptor Set Ref",
            "rdfs:comment": "Reference ID matching a previously exchanged PayloadDescriptorProfile's payloadDescriptorSet."
        },
        {
            "@id": "ies:compactSequenceRef",
            "@type": "rdf:Property",
            "rdfs:label": "compact Sequence Ref",
            "rdfs:comment": "Name of the compact sequence to use from the payloadDescriptorSets."
        },
        {
            "@id": "ies:intervalPeriod",
            "@type": "rdf:Property",
            "rdfs:label": "interval Period",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:intervals",
            "@type": "rdf:Property",
            "rdfs:label": "intervals",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:readings",
            "@type": "rdf:Property",
            "rdfs:label": "readings",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:timePeriod",
            "@type": "rdf:Property",
            "rdfs:label": "time Period",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:touBuckets",
            "@type": "rdf:Property",
            "rdfs:label": "tou Buckets",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:billNumber",
            "@type": "rdf:Property",
            "rdfs:label": "bill Number",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:billDate",
            "@type": "rdf:Property",
            "rdfs:label": "bill Date",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:dueDate",
            "@type": "rdf:Property",
            "rdfs:label": "due Date",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:currency",
            "@type": "rdf:Property",
            "rdfs:label": "currency",
            "rdfs:comment": "ISO 4217 (INR, USD, ...)."
        },
        {
            "@id": "ies:amountDue",
            "@type": "rdf:Property",
            "rdfs:label": "amount Due",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:energyCharges",
            "@type": "rdf:Property",
            "rdfs:label": "energy Charges",
            "rdfs:comment": "Charges for active/reactive energy consumption."
        },
        {
            "@id": "ies:fixedCharges",
            "@type": "rdf:Property",
            "rdfs:label": "fixed Charges",
            "rdfs:comment": "Fixed charges/demand charges."
        },
        {
            "@id": "ies:otherCharges",
            "@type": "rdf:Property",
            "rdfs:label": "other Charges",
            "rdfs:comment": "Other taxes, duties, surcharges, or adjustments."
        },
        {
            "@id": "ies:prepaidBalance",
            "@type": "rdf:Property",
            "rdfs:label": "prepaid Balance",
            "rdfs:comment": "Prepaid remaining balance/credit amount on the account/meter, if applicable."
        },
        {
            "@id": "ies:paymentStatus",
            "@type": "rdf:Property",
            "rdfs:label": "payment Status",
            "rdfs:comment": "Status of the payment, e.g. PAID, UNPAID, PARTIAL."
        },
        {
            "@id": "ies:billVersion",
            "@type": "rdf:Property",
            "rdfs:label": "bill Version",
            "rdfs:comment": "Revision number of this bill for the same billNumber. Starts at 1; increments each time a revised bill is issued for the same period."
        },
        {
            "@id": "ies:billingFrequency",
            "@type": "rdf:Property",
            "rdfs:label": "billing Frequency",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:billGeneratedAt",
            "@type": "rdf:Property",
            "rdfs:label": "bill Generated At",
            "rdfs:comment": "Date-time the bill was generated by the billing system. billDate remains the calendar date printed on the bill."
        },
        {
            "@id": "ies:nextBillDate",
            "@type": "rdf:Property",
            "rdfs:label": "next Bill Date",
            "rdfs:comment": "Expected date of the next bill for this connection."
        },
        {
            "@id": "ies:fppcaCharges",
            "@type": "rdf:Property",
            "rdfs:label": "fppca Charges",
            "rdfs:comment": "Fuel and power purchase cost adjustment (FPPCA / PPAC / FAC) charged on this bill, in `currency`. Negative when a refund/credit."
        },
        {
            "@id": "ies:slabRate",
            "@type": "rdf:Property",
            "rdfs:label": "slab Rate",
            "rdfs:comment": "Applicable energy slab rate for this bill, in `currency` per kWh, as printed on the bill."
        },
        {
            "@id": "ies:taxElectricityDuty",
            "@type": "rdf:Property",
            "rdfs:label": "tax Electricity Duty",
            "rdfs:comment": "Electricity duty levied on this bill, in `currency`."
        },
        {
            "@id": "ies:taxGst",
            "@type": "rdf:Property",
            "rdfs:label": "tax Gst",
            "rdfs:comment": "Goods and services tax charged on this bill, in `currency`."
        },
        {
            "@id": "ies:taxTdsTcs",
            "@type": "rdf:Property",
            "rdfs:label": "tax Tds Tcs",
            "rdfs:comment": "Tax deducted or collected at source that is shown on this bill, in `currency`."
        },
        {
            "@id": "ies:subsidyAmount",
            "@type": "rdf:Property",
            "rdfs:label": "subsidy Amount",
            "rdfs:comment": "Subsidy credited on this bill, in `currency`. Zero or absent when no subsidy applies."
        },
        {
            "@id": "ies:subsidyKwh",
            "@type": "rdf:Property",
            "rdfs:label": "subsidy Kwh",
            "rdfs:comment": "Energy covered by subsidy on this bill, in kWh. Zero or absent when no subsidy applies."
        },
        {
            "@id": "ies:currentBillAmount",
            "@type": "rdf:Property",
            "rdfs:label": "current Bill Amount",
            "rdfs:comment": "Total charged for the current billing period (energy, fixed, other charges, taxes and duties, less subsidy and incentives), before arrears, advance payments and other prior-period adjustments, in `currency`."
        },
        {
            "@id": "ies:arrearsAmount",
            "@type": "rdf:Property",
            "rdfs:label": "arrears Amount",
            "rdfs:comment": "Unpaid amount carried forward from previous bills, in `currency`. Positive when outstanding; negative when a credit balance is carried forward."
        },
        {
            "@id": "ies:advancePayment",
            "@type": "rdf:Property",
            "rdfs:label": "advance Payment",
            "rdfs:comment": "Amount received in advance and adjusted against this bill, in `currency`."
        },
        {
            "@id": "ies:securityDeposit",
            "@type": "rdf:Property",
            "rdfs:label": "security Deposit",
            "rdfs:comment": "Security deposit held against the connection as at billDate, in `currency`. Zero or absent when none is held."
        },
        {
            "@id": "ies:enforcementAmount",
            "@type": "rdf:Property",
            "rdfs:label": "enforcement Amount",
            "rdfs:comment": "Assessment or penalty amount raised through enforcement action (e.g. unauthorised use) included in this bill, in `currency`."
        },
        {
            "@id": "ies:assessedKwh",
            "@type": "rdf:Property",
            "rdfs:label": "assessed Kwh",
            "rdfs:comment": "Energy assessed (estimated) for this bill when the meter reading could not be used, e.g. faulty or tampered meter, in kWh."
        },
        {
            "@id": "ies:touAdjustmentAmount",
            "@type": "rdf:Property",
            "rdfs:label": "tou Adjustment Amount",
            "rdfs:comment": "Net amount added (positive) or reduced (negative) on this bill on account of time-of-use tariff, in `currency`. The billed effect of the touBuckets, not a reading."
        },
        {
            "@id": "ies:openAccessKwh",
            "@type": "rdf:Property",
            "rdfs:label": "open Access Kwh",
            "rdfs:comment": "Energy drawn under open access during this bill's period, in kWh. Absent when the consumer is not an open-access consumer."
        },
        {
            "@id": "ies:openAccessTerm",
            "@type": "rdf:Property",
            "rdfs:label": "open Access Term",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:openAccessContractDemandKw",
            "@type": "rdf:Property",
            "rdfs:label": "open Access Contract Demand Kw",
            "rdfs:comment": "Contracted demand under the open-access arrangement, in kW."
        },
        {
            "@id": "ies:wheelingCharges",
            "@type": "rdf:Property",
            "rdfs:label": "wheeling Charges",
            "rdfs:comment": "Wheeling charges for open-access energy on this bill, in `currency`."
        },
        {
            "@id": "ies:crossSubsidySurcharge",
            "@type": "rdf:Property",
            "rdfs:label": "cross Subsidy Surcharge",
            "rdfs:comment": "Cross-subsidy surcharge for open-access energy on this bill, in `currency`."
        },
        {
            "@id": "ies:additionalSurcharge",
            "@type": "rdf:Property",
            "rdfs:label": "additional Surcharge",
            "rdfs:comment": "Additional surcharge for open-access energy on this bill, in `currency`."
        },
        {
            "@id": "ies:earlyPaymentAmount",
            "@type": "rdf:Property",
            "rdfs:label": "early Payment Amount",
            "rdfs:comment": "Amount payable if paid on or before earlyPaymentDate, in `currency`."
        },
        {
            "@id": "ies:earlyPaymentDate",
            "@type": "rdf:Property",
            "rdfs:label": "early Payment Date",
            "rdfs:comment": "Last date on which earlyPaymentAmount applies."
        },
        {
            "@id": "ies:latePaymentAmount",
            "@type": "rdf:Property",
            "rdfs:label": "late Payment Amount",
            "rdfs:comment": "Amount payable if paid after dueDate, in `currency`."
        },
        {
            "@id": "ies:incentiveAmount",
            "@type": "rdf:Property",
            "rdfs:label": "incentive Amount",
            "rdfs:comment": "Rebate or incentive credited on this bill (e.g. prompt-payment or digital-payment rebate), in `currency`."
        },
        {
            "@id": "ies:discountExpiryDate",
            "@type": "rdf:Property",
            "rdfs:label": "discount Expiry Date",
            "rdfs:comment": "Last date on which any discount or incentive shown on this bill can be availed."
        },
        {
            "@id": "ies:serviceLocation",
            "@type": "rdf:Property",
            "rdfs:label": "service Location",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:timestamp",
            "@type": "rdf:Property",
            "rdfs:label": "timestamp",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:alarms",
            "@type": "rdf:Property",
            "rdfs:label": "alarms",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:events",
            "@type": "rdf:Property",
            "rdfs:label": "events",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:scheme",
            "@type": "rdf:Property",
            "rdfs:label": "scheme",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:value",
            "@type": "rdf:Property",
            "rdfs:label": "value",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:namespace",
            "@type": "rdf:Property",
            "rdfs:label": "namespace",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:start",
            "@type": "rdf:Property",
            "rdfs:label": "start",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:duration",
            "@type": "rdf:Property",
            "rdfs:label": "duration",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:readingType",
            "@type": "rdf:Property",
            "rdfs:label": "reading Type",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:supportedModes",
            "@type": "rdf:Property",
            "rdfs:label": "supported Modes",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:defaultMode",
            "@type": "rdf:Property",
            "rdfs:label": "default Mode",
            "rdfs:comment": ""
        },
        {
            "@id": "schema:name",
            "@type": "rdf:Property",
            "rdfs:label": "name",
            "rdfs:comment": "Full name of the customer as per ID proof."
        },
        {
            "@id": "ies:shortLabel",
            "@type": "rdf:Property",
            "rdfs:label": "short Label",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:unit",
            "@type": "rdf:Property",
            "rdfs:label": "unit",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:phase",
            "@type": "rdf:Property",
            "rdfs:label": "phase",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:flowDirection",
            "@type": "rdf:Property",
            "rdfs:label": "flow Direction",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:accumulationBehaviour",
            "@type": "rdf:Property",
            "rdfs:label": "accumulation Behaviour",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:touZone",
            "@type": "rdf:Property",
            "rdfs:label": "tou Zone",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:payloadDescriptors",
            "@type": "rdf:Property",
            "rdfs:label": "payload Descriptors",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:compactSequences",
            "@type": "rdf:Property",
            "rdfs:label": "compact Sequences",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:sequenceItems",
            "@type": "rdf:Property",
            "rdfs:label": "sequence Items",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:attribute",
            "@type": "rdf:Property",
            "rdfs:label": "attribute",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:obis",
            "@type": "rdf:Property",
            "rdfs:label": "obis",
            "rdfs:comment": "Optional canonical OBIS code when readingType uses a short code."
        },
        {
            "@id": "ies:category",
            "@type": "rdf:Property",
            "rdfs:label": "category",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:reportedMode",
            "@type": "rdf:Property",
            "rdfs:label": "reported Mode",
            "rdfs:comment": ""
        },
        {
            "@id": "ies:multiplier",
            "@type": "rdf:Property",
            "rdfs:label": "multiplier",
            "rdfs:comment": "Decimal scaling factor (e.g. 0.001 for milli, 1000 for kilo). Default value is 1."
        },
        {
            "@id": "ies:accuracy",
            "@type": "rdf:Property",
            "rdfs:label": "accuracy",
            "rdfs:comment": "Accuracy class or precision value, applied after the multiplier."
        },
        {
            "@id": "ies:id",
            "@type": "rdf:Property",
            "rdfs:label": "id",
            "rdfs:comment": "Unique identifier for this specific configuration state."
        },
